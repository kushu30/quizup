PORT=4000
# Comma-separated, no trailing slashes. Production example:
# CORS_ORIGINS=https://quizup.kushu30.me,https://quizup-khaki.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
# Public address of the web app, used in email links (production: https://quizup.kushu30.me)
APP_URL=
# Preferred: Brevo HTTPS API (port 443). Works on hosts that block SMTP, such as Render free.
BREVO_API_KEY=
# Fallback: SMTP (ports 25, 465 and 587 are blocked on Render free).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=QuizUp
MAIL_REPLY_TO=
